<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty scope="context" name="AUDIT_DB_URL" source="audit.datasource.url" defaultValue="jdbc:postgresql://localhost:5432/capstone_one"/>
    <springProperty scope="context" name="AUDIT_DB_WRITER_USERNAME" source="audit.datasource.writer-username" defaultValue="capstone_audit_writer"/>
    <springProperty scope="context" name="AUDIT_DB_WRITER_PASSWORD" source="audit.datasource.writer-password" defaultValue=""/>

    <property name="CONSOLE_LOG_PATTERN"
              value="timestamp=%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%-5level correlationId=%X{correlationId:-none} eventType=%X{eventType:-LOG_EVENT} exceptionType=%X{exceptionType:-none} httpMethod=%X{httpMethod:-none} path=%X{requestPath:-none} status=%X{httpStatus:-none} durationMs=%X{durationMs:-none} message=%msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <logger name="AUDIT_STORAGE_STATUS" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <appender name="ROLLING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/capstone-one.log</file>
        <filter class="com.hdfclife.capstoneone.filter.AuditEventLogFilter"/>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/capstone-one.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="POSTGRES_AUDIT" class="com.hdfclife.capstoneone.logging.AuditLogAppender">
        <filter class="com.hdfclife.capstoneone.filter.AuditEventLogFilter"/>
        <jdbcUrl>${AUDIT_DB_URL}</jdbcUrl>
        <username>${AUDIT_DB_WRITER_USERNAME}</username>
        <password>${AUDIT_DB_WRITER_PASSWORD}</password>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="com.hdfclife.capstoneone" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ROLLING_FILE"/>
        <appender-ref ref="POSTGRES_AUDIT"/>
    </logger>
</configuration>
